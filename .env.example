# Database — SQLite file (dev/test) or PostgreSQL URL (prod).
# The schema is provider-agnostic; switch engines here, not in schema.prisma.
DATABASE_URL="file:./dev.db"

# Simorq Tejarat JetPay credit-consumption API (LOAN_FEATURE_REPORT.md).
# NEVER commit real credentials. The sandbox values come from kalano-sandbox.txt.
JETPAY_BASE_URL="https://sandbox-jetpay.simotechtest.ir"
JETPAY_USERNAME="your-merchant-username"
JETPAY_PASSWORD="your-merchant-password"
JETPAY_TERMINAL_ID="your-terminal-id"
